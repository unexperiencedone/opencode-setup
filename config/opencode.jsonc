{
  "$schema": "https://opencode.ai/config.json",

  // Local first: Qwen 3.5 4B through Ollama, on this laptop, free and offline.
  // Switch inside opencode with /models, or for one run: opencode -m nvidia/<model>.
  "model": "ollama/qwen3.5-4b-coder",
  "small_model": "ollama/qwen3.5-4b-coder",

  "provider": {
    // Local: Ollama's OpenAI-compatible endpoint. The model is the Modelfile in this repo
    // (qwen3.5:4b with a 32k context; Ollama's default is too short for an agent's tools).
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://127.0.0.1:11434/v1" },
      "models": {
        "qwen3.5-4b-coder": { "name": "Qwen 3.5 4B coder (local, 32k)", "tools": true },
        "qwen3.5:4b": { "name": "Qwen 3.5 4B (local, Ollama's default context)", "tools": true }
      }
    },

    // Online: NVIDIA's free API (build.nvidia.com). Key from the environment, never in this file.
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA (online)",
      "options": { "baseURL": "https://integrate.api.nvidia.com/v1", "apiKey": "{env:NVIDIA_API_KEY}" },
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b": { "name": "Nemotron 3 Ultra (online)", "tools": true }
      }
    },

    // Online, optional: Groq and OpenRouter are built into opencode; they only need their
    // keys in the environment (GROQ_API_KEY, OPENROUTER_API_KEY). Nothing to configure here.
  },

  // A proper coding loop in the terminal: read and edit freely, ask before anything else
  // touches the machine, allow the commands that only look or test.
  "permission": {
    "edit": "allow",
    "webfetch": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow", "git diff*": "allow", "git log*": "allow", "git show*": "allow", "git branch*": "allow",
      "ls*": "allow", "cat *": "allow", "head *": "allow", "tail *": "allow", "wc *": "allow",
      "rg *": "allow", "grep *": "allow", "find *": "allow", "pwd": "allow",
      "python -m pytest*": "allow", "python3 -m pytest*": "allow", "pytest*": "allow",
      "python -m unittest*": "allow", "python3 -m unittest*": "allow",
      "npm test*": "allow", "npm run test*": "allow", "npm run lint*": "allow", "npm run build*": "allow",
      "cargo test*": "allow", "cargo check*": "allow", "go test*": "allow",
      "rm -rf*": "deny", "sudo *": "deny", "git push --force*": "deny", "git reset --hard*": "deny"
    }
  },

  "instructions": ["~/.config/opencode/AGENTS.md"],
  "autoupdate": false
}
