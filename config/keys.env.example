# Copy to ~/.config/opencode/keys.env (chmod 600). Never commit the real file.
# Your shell loads it (install.sh adds one line to ~/.bashrc and ~/.zshrc).
# Local Qwen through Ollama needs no key. These are only for the online providers.
export NVIDIA_API_KEY=""        # build.nvidia.com: Nemotron, free tier
export GROQ_API_KEY=""          # console.groq.com, optional
export OPENROUTER_API_KEY=""    # openrouter.ai, optional
